#	$NetBSD: Makefile,v 1.11.40.1 2026/11/04 23:28:30 perseant Exp $

MODULE=		texinfo

CONFIGURE_ARGS=	--program-prefix=${_TOOL_PREFIX}

.include "${.CURDIR}/../Makefile.gnuhost"
.-include "${TOOLDIR}/share/compat/defs.mk"

.if !empty(.MAKE.OS:M*CYGWIN*) && target(install)
.END: install-texinfo
install-texinfo:
	${HOST_SH} ${NETBSDSRCDIR}/tools/binstall/mkmanifest \
	    ${TOOLDIR}/bin/${_TOOL_PREFIX}install-info${HOSTEXEEXT}
.endif

# The host build skips the info directory, since it would also
# build ginfo and infokey.  We still need makedoc to generate the
# sources for the target info program, so build makedoc separately
# using the host config.h generated by configure and install it here.

.if ${USETOOLS} == "yes"
HOST_BINDIR?=		${TOOLDIR}/bin
HOSTPROGNAME?=		${_TOOL_PREFIX}makedoc
HOST_INSTALLPROG?=	${HOST_BINDIR}/${HOSTPROGNAME}${HOSTEXEEXT}
MAKEDOC=		build/info/makedoc${HOSTEXEEXT}

afterinstall: install.makedoc
.PHONY: install.makedoc
install.makedoc: ${HOST_INSTALLPROG}
.ORDER: realinstall ${HOST_INSTALLPROG}

${HOST_INSTALLPROG}:: ${MAKEDOC}
	${_MKTARGET_INSTALL}
	mkdir -p ${HOST_BINDIR}
	${HOST_INSTALL_FILE} -m ${BINMODE} ${.ALLSRC} ${.TARGET}
.if !empty(.MAKE.OS:M*CYGWIN*)
	${HOST_SH} ${NETBSDSRCDIR}/tools/binstall/mkmanifest ${.TARGET}
.endif

.if ${MKUPDATE} == "no"
.PHONY: ${HOST_INSTALLPROG}
.endif
.endif
