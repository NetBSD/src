/*	$NetBSD: ldscript.booters,v 1.1.2.2 2026/11/04 23:20:02 perseant Exp $	*/

/*
 * elf2bb(1) and booters assume that .rodata.str1.1 section precedes .bss,
 * which is not guaranteed by recent binutils. We put the section just
 * behind .rodata as done by older binutils.
 */
SECTIONS
{
  .rodata.str1.1 :
  {
    *(.rodata.str1.1)
  }
}
INSERT AFTER .rodata;
