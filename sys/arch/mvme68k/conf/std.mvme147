#	$NetBSD: std.mvme147,v 1.1 2026/08/04 15:33:29 thorpej Exp $

# Standard devices found on all MVME147 systems.
pcc0		at mainbus0
vmepcc0		at pcc?
clock0		at pcc? ipl 5
zsc*		at pcc? ipl 4
le0		at pcc? ipl 3
wdsc0		at pcc? ipl 2
lpt0		at pcc? ipl 1

zstty*		at zsc? channel ?

vme0		at vmepcc0

scsibus*	at wdsc?
