options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation no;
	notify no;
};

{% include "_common/controls.conf.j2" %}

view "in" {
	allow-transfer { any; };

	zone "example." {
		type primary;
		file "example-in.db";
	};

	zone "broken1." {
		type primary;
		file "broken1.db";
	};

	zone "broken2." {
		type primary;
		file "broken2.db";
	};

	zone "broken3." {
		type primary;
		file "broken3.db";
	};

	zone "broken4." {
		type primary;
		file "broken4.db";
	};

	zone "broken5." {
		type primary;
		file "broken5.db";
	};
};

view "class10" class10 {
	zone "." class10 {
		type hint;
		file "class10.hints";
	};

	zone "example." class10 {
		type primary;
		file "example-class10.db";
	};
};
