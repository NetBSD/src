options {
	{% include_indented "_common/options.conf.j2" %}
	dnstap-identity "ns5";
	dnstap-version "xxx";
	dnstap-output file "dnstap.out";
	dnstap { all; };
	send-cookie no;
	require-server-cookie no;
	dnssec-validation no;
	qname-minimization disabled;
	forwarders { 10.53.0.3; };
	forward only;
};

