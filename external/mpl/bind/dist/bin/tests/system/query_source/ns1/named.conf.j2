{% include "_common/controls.conf.j2" %}

options {
	{% include_indented "_common/options/server.conf.j2" %}
	{% include_indented "_common/options/listen-dual.conf.j2" %}
	recursion no;
	dnssec-validation no;
	query-source @ns.ip@;
	query-source-v6 @ns.ip6@;
