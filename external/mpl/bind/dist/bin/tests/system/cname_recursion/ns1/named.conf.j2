// NS1: root server, authoritative for the CNAME target zone, and
// primary for the catalog zone and its member zone

options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation no;
	allow-transfer { any; };
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type primary;
	file "root.db";
};

zone "external" {
	type primary;
	file "external.db";
};

zone "catalog" {
	type primary;
	file "catalog.db";
};

zone "member" {
	type primary;
	file "member.db";
};
