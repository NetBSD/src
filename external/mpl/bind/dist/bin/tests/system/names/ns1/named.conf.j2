options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	ixfr-from-differences yes;
	check-integrity no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

view compress {
	match-clients { @ns.ip@/32; };
	zone "example" {
		type primary;
		file "example.db";
	};
};

view nocompress {
	match-clients { 10.53.0.2/32; };
	message-compression no;
	zone "example" {
		type primary;
		file "example.db";
	};
};
