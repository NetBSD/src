options {
	{% include_indented "_common/options.conf.j2" %}
	dnssec-validation no;
	recursion no;
};

logging {
	channel default_log {
		file "named_pipe";
		print-time yes;
	};
	category default { default_log; default_debug; };
	category lame-servers { null; };
};

