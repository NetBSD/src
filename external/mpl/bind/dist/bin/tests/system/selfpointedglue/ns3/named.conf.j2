options {
	{% include_indented "_common/options/sources.conf.j2" %}
	{% include_indented "_common/options/server.conf.j2" %}
	listen-on {
		@ns.ip@;
		10.53.0.5;
		10.53.0.6;
		10.53.0.7;
		10.53.0.8;
		10.53.0.9;
		10.53.0.10;
		10.53.1.1;
		10.53.1.2;
		10.53.2.1;
	};
	listen-on-v6 { none; };
	recursion no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "example.tld." {
	type primary;
	file "example.tld.db";
};

zone "example2.tld." {
	type primary;
	file "example2.tld.db";
};
