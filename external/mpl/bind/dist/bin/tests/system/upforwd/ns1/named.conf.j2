key "update.example." {
	algorithm @DEFAULT_HMAC@;
	secret "c3Ryb25nIGVub3VnaCBmb3IgYSBtYW4gYnV0IG1hZGUgZm9yIGEgd29tYW4K";
};

options {
	{% include_indented "_common/options.conf.j2" %}
	tls-port @TLSPORT@;
	listen-on tls ephemeral { @ns.ip@; };
	allow-transfer { any; };
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "example" {
	type primary;
	file "example.db";
	allow-update { key update.example.; 10.53.0.3; };
};

zone "example2" {
	type primary;
	file "example2.db";
	allow-update { key sig0.example2.; };
};

zone "example2-toomanykeys" {
	type primary;
	file "example2-toomanykeys.db";
	allow-update { key sig0.example2-toomanykeys.; };
};

zone "example3" {
	type primary;
	file "example3.db";
	allow-update { key update.example.; 10.53.0.3; };
};
