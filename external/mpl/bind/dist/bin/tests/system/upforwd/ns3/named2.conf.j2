options {
	{% include_indented "_common/options.conf.j2" %}
	tls-port @TLSPORT@;
	listen-on tls ephemeral { @ns.ip@; };
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
	update-quota 1;
};

{% include "_common/controls.conf.j2" %}

zone "example" {
	type secondary;
	file "example.bk";
	allow-update-forwarding { any; };
	primaries { 10.53.0.1; };
};
