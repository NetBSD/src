options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	provide-ixfr no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

view "primary" {
	ixfr-from-differences yes;
	request-ixfr yes;
	zone "test" IN {
		type secondary;
		file "mytest.db";
		primaries { 10.53.0.3; };
	};
	zone "sub.test" IN {
		type secondary;
		file "subtest.db";
		request-ixfr no;
		primaries { 10.53.0.3; };
	};
};
