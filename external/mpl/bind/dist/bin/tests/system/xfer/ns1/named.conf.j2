{% include "_common/controls.conf.j2" %}

options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
};

zone "." {
	type primary;
	file "root.db";
};

{% if enable_only_axfr_max_idle_time | default(False) %}
zone "axfr-max-idle-time" {
	type primary;
	file "axfr-max-idle-time.db";
};
{% else %}
zone "axfr-min-transfer-rate" {
	type primary;
	file "axfr-min-transfer-rate.db";
};

zone "axfr-max-transfer-time" {
	type primary;
	file "axfr-max-transfer-time.db";
};

zone "axfr-rndc-retransfer-force" {
	type primary;
	file "axfr-rndc-retransfer-force.db";
};

{% if enable_some_zones | default(True) %}
zone "secondary" {
	type primary;
	allow-transfer { @ns.ip@; 10.53.0.2; 10.53.0.6; 10.53.0.7; };
	file "sec.db";
};

zone "edns-expire" {
	type primary;
	file "edns-expire.db";
};

zone "xot-primary-try-next" {
	type primary;
	file "xot-primary-try-next.db";
};

zone "axfr-too-big" {
	type primary;
	file "axfr-too-big.db";
};

zone "ixfr-too-big" {
	type primary;
	allow-update { any; };
	file "ixfr-too-big.db";
};

zone "xfer-stats" {
	type primary;
	file "xfer-stats.db";
};

zone "dot-fallback" {
	type primary;
	file "dot-fallback.db";
};
{% endif %}
{% endif %}