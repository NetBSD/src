options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

key tsigzone. {
	algorithm @DEFAULT_HMAC@;
	secret "1234abcd8765";
};

{% include "_common/root.hint.conf" %}

zone "example" {
	type secondary;
	primaries { 10.53.0.2; };
	file "example.bk";
};

zone "primary" {
	type secondary;
	transfer-source @ns.ip@ port @EXTRAPORT1@;
	primaries { 10.53.0.6; };
	file "primary.bk";
};

server 10.53.0.2 {
	keys { tsigzone.; };
};

zone "tsigzone" {
	type secondary;
	primaries { 10.53.0.2; };
	file "tsigzone.bk";
	allow-transfer { key tsigzone.; };
};

zone "mapped" {
	type secondary;
	primaries { 10.53.0.2; };
	masterfile-format raw;
	file "mapped.bk";
};

zone "xfer-stats" {
	type secondary;
	primaries { 10.53.0.1; };
	file "xfer-stats.bk";
};
