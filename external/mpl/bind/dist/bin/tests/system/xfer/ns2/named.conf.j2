options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	recursion no;
	dnssec-validation no;
	ixfr-from-differences yes;
	check-integrity no;
};

{% include "_common/controls.conf.j2" %}

key tsigzone. {
	algorithm @DEFAULT_HMAC@;
	secret "1234abcd8765";
};

acl tzkey {
	key tsigzone.;
};

{% include "_common/root.hint.conf" %}

zone "example" {
	type primary;
	file "example.db";
};

zone "tsigzone" {
	type primary;
	file "tsigzone.db";
	allow-transfer { tzkey; };
};

remote-servers "ns1" port @PORT@ source @ns.ip@ {
	10.53.0.1;
};

zone "secondary" {
	type secondary;
	file "sec.db";
	primaries { ns1; };
	masterfile-format text;
};

zone "mapped" {
	type secondary;
	file "mapped.db";
	masterfile-format text;
	primaries { 10.53.0.100; };
};

zone "dot-fallback" {
	type secondary;
	file "dot-fallback.db";
	primaries {
		10.53.0.1 tls ephemeral;
		10.53.0.1;
	};
};
