options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

{% if FEATURE_LIBXML2 == "1" or FEATURE_JSON_C == "1" %}
statistics-channels {
	inet @ns.ip@ port @EXTRAPORT1@ allow { any; };
};
{% endif %}

zone "." {
	type primary;
	file "root.db";
};

zone "example.info." {
	type primary;
	file "example-info.db";
};

zone "32/1.0.0.127-in-addr.example." {
	type primary;
	file "zone.db";
};
