options {
	{% include_indented "_common/options.conf.j2" %}
	dnssec-validation no;
	qname-minimization disabled;
	zone-statistics yes;
};

{% if FEATURE_LIBXML2 == "1" or FEATURE_JSON_C == "1" %}
statistics-channels {
	inet @ns.ip@ port @EXTRAPORT1@ allow { any; };
};
{% endif %}

{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "root.hint";
};

zone "example" {
	type primary;
	allow-update { any; };
	file "internal.db";
};

zone "a-secondary" {
	type secondary;
	file "sec.bk";
	primaries { 10.53.0.1; };
};
