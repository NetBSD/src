/* Recursive server that is also authoritative for the affected zones. */

options {
	{% include_indented "_common/options.conf.j2" %}
	recursion yes;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}
{% include "_common/root.hint.conf" %}

/*
 * Secondary zones whose backup files carry records above the zone apex.
 * The primaries are unreachable, so the databases are only ever loaded
 * from these files and never replaced by a transfer.
 */

zone "nszone.example" {
	type secondary;
	primaries { 10.53.0.100; };
	file "nszone.db";
	masterfile-format text;
};

zone "dnamezone.example" {
	type secondary;
	primaries { 10.53.0.100; };
	file "dnamezone.db";
	masterfile-format text;
};
