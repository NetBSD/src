/*
 * Root server and the "attacker" infrastructure: the nameserver named by
 * the out-of-zone delegations in the ns2/ns3 databases, serving an apex
 * DNAME for "example." that would poison the "example." namespace in
 * a resolver cache if it were ever followed.
 */

options {
	{% include_indented "_common/options.conf.j2" %}
	recursion no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type primary;
	file "root.db";
};

zone "attacker" {
	type primary;
	file "attacker.db";
};

zone "example" {
	type primary;
	file "example.db";
};
