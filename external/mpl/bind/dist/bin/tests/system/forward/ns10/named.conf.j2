options {
	{% include_indented "_common/options.conf.j2" %}
	minimal-responses no;
	dnssec-validation no;
};

{% include "_common/controls.conf.j2" %}

zone "net." {
	type master;
	file "fakenet.zone";
};

zone "spoofed.net." {
	type master;
	file "spoofednet.zone";
};

zone "sub.local.net." {
	type master;
	file "fakesublocalnet.zone";
};

zone "net2" {
	type master;
	file "fakenet2.zone";
};

zone "net.example.lll" {
	type master;
	file "net.example.lll";
};

zone "sub.local.tld." {
	type master;
	file "fakesublocaltld.zone";
};
