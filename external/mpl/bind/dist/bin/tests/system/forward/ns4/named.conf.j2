{% if FEATURE_FIPS_DH == "1" %}
include "named-tls.conf";
{% endif %}

options {
	{% include_indented "_common/options.conf.j2" %}
	dnssec-validation no;
	minimal-responses yes;

{% if FEATURE_FIPS_DH == "1" %}
	tls-port @TLSPORT@;
{% endif %}

};

{% include "_common/controls.conf.j2" %}

statistics-channels { inet @ns.ip@ port @EXTRAPORT1@ allow { localhost; }; };

zone "." {
	type hint;
	file "root.db";
};

zone "example5." {
	type forward;
	forward only;
	forwarders { 10.53.0.2; };
};

zone "grafted" {
	type forward;
	forward only;
	forwarders { 10.53.0.2; };
};

zone "malicious." {
	type primary;
	file "malicious.db";
};

zone "sibling.tld" {
	type primary;
	file "sibling.tld.db";
};
