options {
	{% include_indented "_common/options.conf.j2" %}
	allow-transfer { any; };
	dnssec-validation no;
	check-names master ignore;
	check-names slave ignore;
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "root.hints";
};

zone "master-ignore.update" {
	type primary;
	file "master-ignore.update.db";
	allow-update { any; };
};

zone "primary-ignore.update" {
	type secondary;
	primaries { 10.53.0.4; };
	file "primary-ignore.update.db";
};
