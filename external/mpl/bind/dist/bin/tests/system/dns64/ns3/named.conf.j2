// NS3

acl rfc1918 { 10/8; 192.168/16; 172.16/12; };

options {
	{% include_indented "_common/options/sources-dual.conf.j2" %}
	{% include_indented "_common/options/listen-dual.conf.j2" %}
	port @EXTRAPORT1@;
	pid-file "named.pid";
	listen-on port @PORT@ { @ns.ip@; };	// for start.pl
	dnssec-validation no;
	allow-recursion { any; };
	resolver-use-dns64 yes;

	dns64 fd92:7065:b8e:fffe::/96 {
		clients { any; };
		mapped { 10.53.0.4; !rfc1918; any; };
		suffix ::;
	};
};

{% include "_common/controls.conf.j2" %}

zone "." {
	type hint;
	file "hints";
};
