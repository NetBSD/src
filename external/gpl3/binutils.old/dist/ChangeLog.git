	...
	==================^M
	WARNING: ThreadSanitizer: signal handler spoils errno (pid=25422)^M
	    #0 handler_wrapper gdb/posix-hdep.c:66^M
	    #1 decltype ({parm#2}({parm#3}...)) gdb::handle_eintr<>() \
	         gdbsupport/eintr.h:67^M
