.ifndef _EXTERNAL_GPL3_GCC_USR_BIN_MAKEFILE_LIBCPP_
_EXTERNAL_GPL3_GCC_USR_BIN_MAKEFILE_LIBCPP_=1

.include <bsd.own.mk>

LIBCPPOBJ!=		cd ${.CURDIR}/../libcpp && ${PRINTOBJDIR}
DPADD+=			${LIBCPPOBJ}/libcpp.a
LDADD+=			${LIBCPPOBJ}/libcpp.a

.endif
